# Shopify App Configuration
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here
SHOPIFY_APP_URL=https://your-domain.com
SCOPES=read_orders,read_customers,write_metaobject_definitions,write_metaobjects,write_products

# Database (PostgreSQL)
DATABASE_URL=postgresql://reviews_user:reviews_password@db:5432/reviews_db

# PostgreSQL Container Config
POSTGRES_USER=reviews_user
POSTGRES_PASSWORD=reviews_password
POSTGRES_DB=reviews_db

# Node
NODE_ENV=production
PORT=3000
