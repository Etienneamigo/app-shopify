{% assign current_product = product | default: block.settings.product %}

<div
  style="
    padding: 24px;
    border: 1px solid #e5e5e5;
    border-radius: 12px;
    background: #ffffff;
    margin: 16px 0;
  "
>
  <h2 style="margin: 0 0 8px; font-size: 24px;">Avis clients</h2>

  {% if current_product %}
    <p style="margin: 0; color: #555;">
      Bloc de test lié au produit :
      <strong>{{ current_product.title }}</strong>
    </p>
  {% else %}
    <p style="margin: 0; color: #555;">
      Bloc de test des avis. Aucun produit détecté pour l’instant.
    </p>
  {% endif %}
</div>

{% schema %}
{
  "name": "Product Reviews",
  "target": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Produit", "autofill": true }
  ]
}
{% endschema %}